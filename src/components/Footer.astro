---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
---

<footer>
	<div class="wrap">
		<span>Brian Amadio · Melbourne</span>
		<span class="links">
			<a href={GITHUB_URL}>GitHub</a>
			<a href={LINKEDIN_URL}>LinkedIn</a>
		</span>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--rule);
		padding: 1.75rem 0 3rem;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.wrap {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
	}
	.links {
		display: flex;
		gap: 1.25rem;
		margin: 0;
	}
</style>
