---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const { limit } = Astro.props;
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, limit);
---

<ul class="rows posts">
	{posts.map((post) => (
		<li>
			<span class="meta"><FormattedDate date={post.data.pubDate} /></span>
			<a class="row-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
		</li>
	))}
</ul>
